<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleDisplayName</key><string>Vertex</string>
    <key>CFBundleShortVersionString</key><string>1.1</string>
    <key>CFBundleVersion</key><string>2</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>O Vertex anuncia o serviço de pareamento local necessário para o Modo Desenvolvedor do iOS.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_remotepairing-pairable-host._tcp</string>
        <string>_remotepairing-manual-pairing._tcp</string>
        <string>_stikpairprobe._tcp</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array><string>$(PRODUCT_BUNDLE_IDENTIFIER).pairing</string></array>
    <key>LSSupportsOpeningDocumentsInPlace</key><true/>
    <key>UIFileSharingEnabled</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UIRequiredDeviceCapabilities</key>
    <array><string>arm64</string></array>
</dict>
</plist>
